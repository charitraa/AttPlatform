# =============================================================================
# ATT Platform — environment configuration
# Copy to `.env` and adjust. NEVER commit `.env`. All values below are
# development placeholders.
# =============================================================================

ENVIRONMENT=development

# ---- Django -----------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.dev
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me-dev-only-secret-key-not-for-production-use-0000
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
FRONTEND_URL=http://localhost:5173

# ---- JWT --------------------------------------------------------------------
# Defaults to DJANGO_SECRET_KEY if empty. Use a separate value in production.
JWT_SIGNING_KEY=
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
# Refresh cookie `Secure` flag; defaults to true unless DJANGO_DEBUG=true.
# REFRESH_COOKIE_SECURE=true

# ---- Accounts ---------------------------------------------------------------
REGISTRATION_ENABLED=false
INVITATION_EXPIRY_DAYS=7
PASSWORD_RESET_TIMEOUT=3600
# Password used by `manage.py seed_demo` (development only).
DEMO_PASSWORD=Demo!Pass2026

# ---- PostgreSQL -------------------------------------------------------------
POSTGRES_DB=att
POSTGRES_USER=att
POSTGRES_PASSWORD=att_dev_password
# Docker Compose overrides the host to `db`. For local (non-Docker) runs:
DATABASE_URL=postgres://att:att_dev_password@localhost:5432/att

# ---- Redis (broker, channel layer, cache) ------------------------------------
# Docker Compose overrides the host to `redis`.
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CHANNELS_REDIS_URL=redis://localhost:6379/3

# ---- Email ------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=ATT Platform <no-reply@att.local>

# ---- AI engine (server-side only; never exposed to the frontend) -------------
# mock | anthropic | openai_compatible
#
# NVIDIA API catalog (OpenAI-compatible), verified 2026-11-12:
#   AI_PROVIDER=openai_compatible
#   AI_BASE_URL=https://integrate.api.nvidia.com/v1
#   AI_MODEL=nvidia/nemotron-3-ultra-550b-a55b
#   AI_API_KEY=nvapi-...            (from build.nvidia.com; keep it in .env only)
#   AI_TIMEOUT_SECONDS=60           (reasoning models take 10-25 s per call)
# Not every listed model is enabled for every account (404), and retired ones return 410.
AI_PROVIDER=mock
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=3
AI_AUTO_APPLY_MIN_CONFIDENCE=0.85

# ---- Secrets at rest ---------------------------------------------------------
# Fernet keys (comma-separated, newest first) for integration credentials.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEYS=

# ---- Uploads / rate limits / logging ----------------------------------------
MAX_UPLOAD_SIZE_MB=20
THROTTLE_ANON=30/min
THROTTLE_USER=600/min
THROTTLE_AUTH=5/min
THROTTLE_AUTH_IP=30/min
THROTTLE_SESSION=60/min
THROTTLE_SYSTEM=120/min
# Trusted reverse proxies in front of Django (1 behind the bundled nginx; 0 when hitting Django directly).
NUM_PROXIES=0
LOG_LEVEL=INFO
LOG_FORMAT=text

# ---- Ports published by Docker Compose --------------------------------------
NGINX_PORT=8080
BACKEND_PORT=8000
FRONTEND_PORT=5173

# ---- Frontend (public values only — bundled into the browser) ---------------
VITE_API_BASE_URL=/api/v1
VITE_WS_URL=
