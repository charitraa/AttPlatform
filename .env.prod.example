# ATT Platform — production environment. Copy to .env.prod and fill in EVERY value.
# Never commit .env.prod. Generate secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# ---- Site ---------------------------------------------------------------------
# 50+ random characters
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=att.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://att.example.com
CORS_ALLOWED_ORIGINS=https://att.example.com
# Links in emails and notifications
FRONTEND_URL=https://att.example.com
# Shown as the inbound webhook base URL
PUBLIC_API_URL=https://att.example.com
REFRESH_COOKIE_SECURE=true
# Self-service organization sign-up
REGISTRATION_ENABLED=false
LOG_LEVEL=INFO
LOG_FORMAT=json
# SENTRY_DSN=

# ---- Database (also used by the db container) ---------------------------------
POSTGRES_DB=att
POSTGRES_USER=att
# Long random value
POSTGRES_PASSWORD=

# ---- Secrets at rest -------------------------------------------------------------
# Fernet key(s), newest first. BACK THESE UP: without them stored integration
# credentials (WhatsApp, Twilio, mailbox passwords) can't be decrypted.
FIELD_ENCRYPTION_KEYS=
# Optional: defaults to DJANGO_SECRET_KEY
# JWT_SIGNING_KEY=

# ---- Email -----------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=ATT Platform <support@example.com>

# ---- AI (mock = offline demo; openai_compatible or anthropic for a real model) ----
AI_PROVIDER=mock
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=
AI_TIMEOUT_SECONDS=60

# ---- Integrations ------------------------------------------------------------------
WEBHOOKS_ALLOW_HTTP=false

# ---- Landing page ---------------------------------------------------------------
# Address for the "Request a demo" button (hidden when empty). Baked in at build time.
CONTACT_EMAIL=

# ---- Compose ------------------------------------------------------------------------
CELERY_CONCURRENCY=4
# Directory holding fullchain.pem and privkey.pem
CERTS_DIR=./certs
# WEB_HTTP_PORT=80
# WEB_HTTPS_PORT=443
